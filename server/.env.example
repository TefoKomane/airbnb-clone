# Copy this file to .env and fill in your own values.
# Never commit the real .env file to GitHub.

# Port the Express server will run on
PORT=5000

# Your MongoDB Atlas connection string
# See API_SECURITY.md in the project root for how to generate this
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/airbnb-clone?retryWrites=true&w=majority

# A long random string used to sign JWT tokens
# See API_SECURITY.md for how to generate this safely
JWT_SECRET=replace_this_with_a_long_random_string

# How long a JWT stays valid for
JWT_EXPIRES_IN=7d

# The URLs your frontend apps run on, used for CORS
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
