{
  "name": "airbnb-clone-server",
  "version": "1.0.0",
  "description": "Backend API for the Airbnb clone project. Handles accommodations, reservations and user authentication.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "setupFiles": ["./tests/setup.js"],
    "testTimeout": 30000
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.12.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
